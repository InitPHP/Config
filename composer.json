{
    "name": "initphp/config",
    "description": "Advanced configuration manager for PHP with dotted-path access, file/directory/class loaders and a static facade.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "php",
        "config",
        "configuration",
        "config-manager",
        "dot-notation",
        "dotted-path",
        "settings",
        "parameter-bag",
        "php-library",
        "initphp"
    ],
    "authors": [
        {
            "name": "Muhammet ŞAFAK",
            "email": "info@muhammetsafak.com.tr",
            "role": "Developer",
            "homepage": "https://www.muhammetsafak.com.tr"
        }
    ],
    "support": {
        "source": "https://github.com/InitPHP/Config",
        "issues": "https://github.com/InitPHP/Config/issues"
    },
    "autoload": {
        "psr-4": {
            "InitPHP\\Config\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "InitPHP\\Config\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "require": {
        "php": "^8.1",
        "initphp/parameterbag": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "phpstan/phpstan": "^1.12",
        "friendsofphp/php-cs-fixer": "^3.64"
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html=build/coverage",
        "analyse": "phpstan analyse",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix"
    },
    "config": {
        "sort-packages": true
    }
}
